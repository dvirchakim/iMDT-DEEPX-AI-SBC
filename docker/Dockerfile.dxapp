FROM ubuntu:18.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    build-essential \
    gcc-aarch64-linux-gnu \
    g++-aarch64-linux-gnu \
    ninja-build \
    git \
    wget \
    python3 \
    python3-pip \
    pkg-config \
    libncurses-dev \
    libssl-dev \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# Install CMake 3.22
RUN wget -qO- https://cmake.org/files/v3.22/cmake-3.22.6-linux-x86_64.tar.gz | tar xz -C /opt && \
    ln -s /opt/cmake-3.22.6-linux-x86_64/bin/cmake /usr/local/bin/cmake && \
    ln -s /opt/cmake-3.22.6-linux-x86_64/bin/ctest /usr/local/bin/ctest

# Download and build OpenCV 4.5.5 for ARM64 cross-compilation
RUN wget -q https://github.com/opencv/opencv/archive/4.5.5.zip -O opencv.zip && \
    unzip -q opencv.zip && \
    cd opencv-4.5.5 && \
    mkdir build && cd build && \
    cmake -DCMAKE_TOOLCHAIN_FILE=../platforms/linux/aarch64-gnu.toolchain.cmake \
          -DCMAKE_BUILD_TYPE=Release \
          -DBUILD_SHARED_LIBS=ON \
          -DWITH_GTK=OFF \
          -DWITH_QT=OFF \
          -DWITH_FFMPEG=OFF \
          -DWITH_V4L=OFF \
          -DWITH_GSTREAMER=OFF \
          -DBUILD_opencv_python2=OFF \
          -DBUILD_opencv_python3=OFF \
          -DBUILD_TESTS=OFF \
          -DBUILD_PERF_TESTS=OFF \
          -DBUILD_EXAMPLES=OFF \
          -DCMAKE_INSTALL_PREFIX=/opt/opencv-aarch64 \
          .. && \
    make -j$(nproc) && \
    make install && \
    cd ../.. && rm -rf opencv-4.5.5 opencv.zip

WORKDIR /build

CMD ["/bin/bash"]
